generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  fullname          String
  email             String             @unique
  password          String
  role              UserRole           @default(USER)
  phone             String?
  address           String?
  profilePicture    String?
  employeeId        String?            @unique
  department        String?
  emergencyContact  String?
  dateOfBirth       DateTime?
  mustChangePassword Boolean           @default(false)
  isSuspended       Boolean            @default(false)
  suspendedReason   String?
  ratings           Float? // average rating
  rides             Ride[]             @relation("RiderRides")
  rideRequests      RideRequest[]
  messages          Message[]          @relation("UserMessages")
  passengerRides    Ride[]             @relation("RidePassengers")
  createdRides      Ride[]             @relation("CreatedUser")
  ratingsGiven      Rating[]           @relation("FromUser")
  ratingsReceived   Rating[]           @relation("ToUser")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  karmaPoints       Int                @default(0) // Total karma points
  creditScore       Int                @default(0) // Total credit score for passengers
  karmaTransactions KarmaTransaction[]
  feedbackGiven     Feedback[]         @relation("FromUser")
  feedbackReceived  Feedback[]         @relation("ToUser")
  refreshTokens     RefreshToken[] // JWT refresh tokens
  riderApplication  RiderApplication?
}

model RiderApplication {
  id                     Int                 @id @default(autoincrement())
  userId                 Int                 @unique
  drivingLicenseNumber   String
  drivingLicenseImageUrl String
  vehicleNumber          String
  vehicleType            String
  vehicleModel           String
  vehicleColor           String
  vehicleRegistrationUrl String
  status                 RiderApprovalStatus @default(PENDING_RIDER_APPROVAL)
  rejectionReason        String?
  reviewedAt             DateTime?
  reviewedById           Int?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Ride {
  id                     Int           @id @default(autoincrement())
  from                   String
  fromLat                Float?
  fromLng                Float?
  to                     String
  toLat                  Float?
  toLng                  Float?
  message                String?
  role                   String
  timestamp              DateTime      @default(now())
  createdBy              Int
  estimatedTimeOfArrival Int?
  riderId                Int?
  passengerId            Int?
  status                 RideStatus    @default(ACTIVE)
  distance               Float?
  co2Saved               Float?
  peopleImpacted         Int?
  matchGroupId           String?
  feedback               Feedback[]
  messages               Message[]
  ratings                Rating[]
  createdByUser          User          @relation("CreatedUser", fields: [createdBy], references: [id])
  rider                  User?         @relation("RiderRides", fields: [riderId], references: [id])
  requests               RideRequest[]
  passengers             User[]        @relation("RidePassengers")
}

model RideRequest {
  id          Int      @id @default(autoincrement())
  rideId      Int
  passengerId Int
  status      String
  createdAt   DateTime @default(now())
  passenger   User     @relation(fields: [passengerId], references: [id])
  ride        Ride     @relation(fields: [rideId], references: [id])
}

model Rating {
  id         Int      @id @default(autoincrement())
  rideId     Int
  fromUserId Int
  toUserId   Int
  score      Int
  comment    String?
  createdAt  DateTime @default(now())
  fromUser   User     @relation("FromUser", fields: [fromUserId], references: [id])
  ride       Ride     @relation(fields: [rideId], references: [id])
  toUser     User     @relation("ToUser", fields: [toUserId], references: [id])
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  senderId  Int
  rideId    Int?
  createdAt DateTime @default(now())
  ride      Ride?    @relation(fields: [rideId], references: [id])
  sender    User     @relation("UserMessages", fields: [senderId], references: [id])
}

model KarmaTransaction {
  id             Int               @id @default(autoincrement())
  user           User              @relation(fields: [userId], references: [id])
  userId         Int
  points         Int
  type           String
  reason         String?
  rewardName     String?
  redemptionCode String?
  status         RedemptionStatus?
  expiresAt      DateTime?
  usedAt         DateTime?
  createdAt      DateTime          @default(now())

  @@index([userId])
  @@index([redemptionCode])
}

model Feedback {
  id         Int      @id @default(autoincrement())
  ride       Ride     @relation(fields: [rideId], references: [id])
  rideId     Int
  fromUser   User     @relation("FromUser", fields: [fromUserId], references: [id])
  fromUserId Int
  toUser     User     @relation("ToUser", fields: [toUserId], references: [id])
  toUserId   Int
  role       String // role of the person giving feedback (rider/passenger)
  emoji      Int // emoji reaction index: 0=😊, 1=😐, 2=😠
  comment    String? // optional comment
  createdAt  DateTime @default(now())

  @@unique([rideId, fromUserId, toUserId]) // Prevent duplicate feedback
}

enum UserRole {
  USER
  ADMIN
}

enum RiderApprovalStatus {
  PENDING_RIDER_APPROVAL
  APPROVED_RIDER
  REJECTED_RIDER
}

enum RideStatus {
  IDLE
  ACTIVE
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum RedemptionStatus {
  ACTIVE
  USED
  EXPIRED
  LOCKED
}
